---
interface Props {
  title:      string;
  town:       string;
  excerpt:    string;
  slug:       string;
  order:      number;
  heroImage?: string;
  tags?:      string[];
}

const { title, town, excerpt, slug, order, heroImage, tags = [] } = Astro.props;
const orderLabel = order.toString().padStart(2, '0');
---

<a href={`/stories/${slug}/`} class="story-card">
  <div class="card-image">
    {heroImage
      ? <img src={`/images/${heroImage}`} alt={title} loading="lazy" width="640" height="360" />
      : (
        <div class="card-placeholder" aria-hidden="true">
          <span>{orderLabel}</span>
        </div>
      )
    }
    <span class="card-badge">{orderLabel}</span>
  </div>

  <div class="card-body">
    <p class="card-town">{town}</p>
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{excerpt}</p>

    {tags.length > 0 && (
      <ul class="card-tags" role="list" aria-label="Story tags">
        {tags.slice(0, 3).map(tag => <li>{tag}</li>)}
      </ul>
    )}

    <span class="card-cta" aria-hidden="true">Read the Story &rarr;</span>
  </div>
</a>

<style>
  .story-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
    height: 100%;
  }
  .story-card:hover {
    border-color: var(--color-accent-amber);
    transform: translateY(-3px);
    text-decoration: none;
  }

  .card-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-elevated);
    flex-shrink: 0;
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .story-card:hover .card-image img { transform: scale(1.03); }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0d1117 0%, #1a1f2e 100%);
  }
  .card-placeholder span {
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--color-accent-amber);
    opacity: 0.12;
  }

  .card-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    background: var(--color-accent-amber);
    color: var(--color-bg);
    padding: 2px 7px;
    border-radius: 2px;
  }

  .card-body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .card-town {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-green);
    margin: 0;
  }

  .card-title {
    font-size: 1.35rem;
    color: var(--color-text);
    margin: 0;
    line-height: 1.15;
  }

  .card-excerpt {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .card-tags li {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-bg-elevated);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 2px 7px;
    border-radius: 2px;
  }

  .card-cta {
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--color-accent-amber);
    margin-top: auto;
    padding-top: var(--space-sm);
  }
</style>
