---
import BaseLayout from '../layouts/BaseLayout.astro';

// Check if PDF file exists — when it's added to public/, update this to true
const pdfReady = true;
const pdfPath  = '/spooky-route-66-presentation.pdf';
---

<BaseLayout
  title="Slideshow"
  description="Download or follow along with the Spooky Route 66 presentation from Phoenix Fan Fusion 2026."
>

  <div class="container">

    <header class="page-header">
      <h1>THE PRESENTATION</h1>
      <p>100 Years of Arizona's Haunted Route 66</p>
    </header>

    {pdfReady ? (
      <section class="pdf-section">
        <p class="pdf-intro">
          Follow along on your phone or download to keep forever.
          This is the full slide show from our Phoenix Fan Fusion 2026 panel.
        </p>
        <div class="pdf-actions">
          <a href={pdfPath} download class="btn-primary">Download PDF</a>
        </div>
        <div class="pdf-viewer">
          <iframe
            src={pdfPath}
            title="Spooky Route 66 Presentation"
            width="100%"
            height="600"
            loading="lazy"
          ></iframe>
        </div>
      </section>
    ) : (
      <section class="pdf-pending">
        <div class="pending-card">
          <p class="pending-label">COMING SOON</p>
          <h2>Presentation PDF</h2>
          <p>
            The slide show will be posted here after Phoenix Fan Fusion 2026
            on June 6. Check back after the panel!
          </p>
          <p class="pending-event">
            <strong>Saturday June 6, 2026 &bull; 12–1 PM</strong><br />
            Room North 128AB Horror &bull; Phoenix Fan Fusion
          </p>
          <a href="/stories/" class="btn-secondary">Explore the Stories Now</a>
        </div>
      </section>
    )}

    <section class="further-reading">
      <h2>FURTHER READING</h2>
      <div class="book-card">
        <div class="book-info">
          <h3>Arizona's Haunted Route 66</h3>
          <p class="book-author">by Debe Branning</p>
          <p class="book-publisher">Published by Haunted America</p>
          <p>
            Our co-presenter Debe Branning documented her own six-day paranormal investigation
            of Arizona's Route 66 in this book. It covers many of the same locations featured
            in our presentation, with the depth and detail that comes from years of field research
            with Arizona's MVD Ghostchasers.
          </p>
          <p>
            If tonight's panel left you wanting more, this is the place to start.
          </p>
        </div>
      </div>
    </section>

  </div>

</BaseLayout>

<style>
  .page-header {
    padding: var(--space-lg) 0 var(--space-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }
  .page-header h1 { font-size: clamp(2rem, 7vw, 3.5rem); margin: 0 0 0.3rem; }
  .page-header p  { color: var(--color-text-muted); font-style: italic; margin: 0; }

  /* ── PDF ready state ── */
  .pdf-section { margin-bottom: var(--space-xl); }

  .pdf-intro {
    max-width: 560px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
  }

  .pdf-actions { margin-bottom: var(--space-md); }

  .pdf-viewer {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-surface);
  }
  .pdf-viewer iframe { display: block; border: none; }

  /* ── PDF pending state ── */
  .pdf-pending {
    display: flex;
    justify-content: center;
    margin-bottom: var(--space-xl);
  }

  .pending-card {
    max-width: 520px;
    width: 100%;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    text-align: center;
    align-items: center;
  }

  .pending-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-amber);
    border: 1px solid var(--color-accent-amber);
    padding: 3px 12px;
    border-radius: 2px;
    margin: 0;
  }

  .pending-card h2 { font-size: 2rem; margin: 0; }

  .pending-card p {
    color: var(--color-text-muted);
    max-width: 380px;
    margin: 0;
  }

  .pending-event {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ── Further reading ── */
  .further-reading {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-lg);
    padding-bottom: var(--space-xl);
  }

  .further-reading h2 {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    margin-bottom: var(--space-lg);
  }

  .book-card {
    max-width: 560px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent-amber);
    border-radius: var(--radius);
    padding: var(--space-md);
  }

  .book-info h3 {
    font-size: 1.4rem;
    margin: 0 0 0.2rem;
    color: var(--color-text);
  }

  .book-author {
    font-style: italic;
    color: var(--color-accent-amber);
    margin: 0 0 0.2rem;
  }

  .book-publisher {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
  }

  .book-info p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
