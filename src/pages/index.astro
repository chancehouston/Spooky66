---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import { getCollection } from 'astro:content';

const stories = await getCollection('stories');
const sorted  = stories.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Home"
  description="13 haunted locations along Arizona's Route 66 — 100 years of ghost stories from the desert."
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-label">PHOENIX FAN FUSION 2026</p>
      <h1 class="hero-title">SPOOKY<br />ROUTE 66</h1>
      <p class="hero-sub">100 YEARS OF GHOST STORIES FROM THE DESERT</p>
      <p class="hero-desc">
        Thirteen haunted locations along Arizona's 400 miles of the Mother Road —
        from the cursed bones of the Petrified Forest to the phantom hitchhikers of
        the open desert. The spirits never left.
      </p>
      <div class="hero-ctas">
        <a href="/stories/" class="btn-primary">Explore the Stories</a>
        <a href="/map/"     class="btn-secondary">See the Map</a>
        <a href="/spooky-route-66-presentation.pdf" download class="btn-secondary">Download PDF</a>
      </div>
      <p class="hero-event">
        Sat June 6, 2026 &bull; 12–1 PM &bull; Room North 128AB Horror &bull;
        <a href="https://memberships.phoenixfanfusion.com/schedules/view/924392" target="_blank" rel="noopener noreferrer">
          Phoenix Fan Fusion
        </a>
      </p>
    </div>
  </section>

  <!-- ── Stories Grid ──────────────────────────────────────── -->
  <section class="stories-section">
    <div class="container">
      <div class="section-header">
        <h2>13 HAUNTED LOCATIONS</h2>
        <p>East to west along Arizona's Route 66</p>
      </div>
      <div class="story-grid">
        {sorted.map(story => (
          <StoryCard
            title={story.data.title}
            town={story.data.town}
            excerpt={story.data.excerpt}
            slug={story.slug}
            order={story.data.order}
            heroImage={story.data.heroImage}
            tags={story.data.tags}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTAs ─────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="container cta-grid">
      <div class="cta-card">
        <h2>PLAN YOUR ROAD TRIP</h2>
        <p>
          Our six-day itinerary covers all 13 haunted stops with lodging recommendations,
          drive times, and stories you won't hear in the presentation.
        </p>
        <a href="/trip-planner/" class="btn-primary">Plan Your Trip</a>
      </div>
      <div class="cta-card">
        <h2>THE PRESENTATION</h2>
        <p>
          Download or follow along with the full slide show from our
          Phoenix Fan Fusion 2026 panel.
        </p>
        <a href="/slideshow/" class="btn-primary">View Slideshow</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xl) var(--space-md);
    background:
      radial-gradient(ellipse 80% 60% at 50% 40%, #1a1f2e 0%, transparent 70%),
      linear-gradient(180deg, #0a0d14 0%, #0d1117 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent-amber), transparent);
  }

  .hero-inner {
    max-width: 700px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .hero-label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    color: var(--color-accent-amber);
    margin: 0;
    border: 1px solid var(--color-accent-amber);
    padding: 3px 12px;
    border-radius: 2px;
  }

  .hero-title {
    font-size: clamp(4rem, 16vw, 9rem);
    letter-spacing: 0.06em;
    line-height: 0.92;
    color: var(--color-text);
    margin: var(--space-sm) 0 0;
    text-shadow: 0 0 60px rgba(232, 132, 26, 0.2);
  }

  .hero-sub {
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 2.5vw, 1rem);
    letter-spacing: 0.18em;
    color: var(--color-accent-amber);
    margin: 0;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 520px;
    line-height: 1.65;
    margin: var(--space-sm) 0;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-xs);
  }

  .hero-event {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: var(--space-sm) 0 0;
  }
  .hero-event a { color: var(--color-text-muted); }
  .hero-event a:hover { color: var(--color-accent-amber); }

  /* ── Stories ── */
  .stories-section { padding: var(--space-xl) 0; }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-lg);
  }
  .section-header h2 {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }
  .section-header p {
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 900px) { .story-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .story-grid { grid-template-columns: 1fr; } }

  /* ── CTAs ── */
  .cta-section {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
  }

  .cta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .cta-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .cta-card h2 { font-size: 1.8rem; }
  .cta-card p { color: var(--color-text-muted); }

  @media (max-width: 640px) { .cta-grid { grid-template-columns: 1fr; } }
</style>
