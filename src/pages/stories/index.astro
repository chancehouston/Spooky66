---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getCollection } from 'astro:content';

const stories = await getCollection('stories');
const sorted  = stories.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="The Stories"
  description="13 haunted locations along Arizona's Route 66, from the Petrified Forest to Oatman."
>

  <div class="container">
    <header class="page-header">
      <h1>13 HAUNTED LOCATIONS</h1>
      <p>East to west along Arizona's Route 66</p>
      <a href="/map/" class="btn-secondary map-link">View on the Map</a>
    </header>

    <div class="story-grid">
      {sorted.map(story => (
        <StoryCard
          title={story.data.title}
          town={story.data.town}
          excerpt={story.data.excerpt}
          slug={story.slug}
          order={story.data.order}
          heroImage={story.data.heroImage}
          tags={story.data.tags}
        />
      ))}
    </div>
  </div>

</BaseLayout>

<style>
  .page-header {
    padding: var(--space-lg) 0 var(--space-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }
  .page-header h1 {
    font-size: clamp(2rem, 7vw, 3.5rem);
    margin: 0;
  }
  .page-header p {
    color: var(--color-text-muted);
    font-style: italic;
    margin: 0;
  }
  .map-link { align-self: flex-start; }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
  }

  @media (max-width: 900px) { .story-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .story-grid { grid-template-columns: 1fr; } }
</style>
