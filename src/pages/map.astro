---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const stories = await getCollection('stories');
const sorted  = stories.sort((a, b) => a.data.order - b.data.order);

const mapData = sorted.map(s => ({
  title:       s.data.title,
  slug:        s.slug,
  town:        s.data.town,
  order:       s.data.order,
  excerpt:     s.data.excerpt,
  coordinates: s.data.coordinates,
}));
---

<BaseLayout
  title="Interactive Map"
  description="Interactive map of all 13 haunted Route 66 locations in Arizona."
  mainClass="map-page"
>

  <div id="map" data-stories={JSON.stringify(mapData)} aria-label="Interactive map of haunted Route 66 locations"></div>

  <div class="map-hint" id="map-hint">
    <p>Tap any pin to read the story</p>
  </div>

</BaseLayout>

<!-- Leaflet CSS — bundled by Vite alongside the JS -->
<style is:global>
  @import 'leaflet/dist/leaflet.css';
</style>

<style>
  :global(main.map-page) {
    padding: 0;
    overflow: hidden;
  }

  #map {
    width: 100%;
    height: calc(100vh - var(--nav-h));
  }

  .map-hint {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(10, 13, 20, 0.85);
    border: 1px solid var(--color-accent-amber);
    border-radius: 20px;
    padding: 6px 18px;
    pointer-events: none;
    z-index: 1000;
    transition: opacity 0.5s;
  }
  .map-hint p {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-accent-amber);
    margin: 0;
  }
  .map-hint.hidden { opacity: 0; }

  :global(.ghost-pin) {
    filter: drop-shadow(0 2px 6px rgba(232, 132, 26, 0.5));
    transition: filter 0.2s;
    cursor: pointer;
  }
  :global(.ghost-pin:hover) {
    filter: drop-shadow(0 2px 12px rgba(232, 132, 26, 0.9));
  }
</style>

<script>
  import L from 'leaflet';

  const el      = document.getElementById('map')!;
  const hint    = document.getElementById('map-hint');
  const rawData = el.dataset.stories ?? '[]';
  const stops: Array<{
    title: string; slug: string; town: string;
    order: number; excerpt: string; coordinates: [number, number];
  }> = JSON.parse(rawData);

  // ── Ghost pin SVG icon ─────────────────────────────────────
  function ghostIcon(order: number) {
    const label = order.toString().padStart(2, '0');
    const svg = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 46" width="36" height="46">
        <path d="M18 2C10 2 4 9 4 18L4 40 Q4 44 7.5 42 L11 40 Q14.5 43 18 40 Q21.5 43 25 40 L28.5 42 Q32 44 32 40 L32 18 C32 9 26 2 18 2Z"
              fill="#e8841a" stroke="rgba(10,13,20,0.4)" stroke-width="1"/>
        <circle cx="12" cy="17" r="3" fill="#0a0d14"/>
        <circle cx="24" cy="17" r="3" fill="#0a0d14"/>
        <text x="18" y="33" text-anchor="middle" fill="#0a0d14"
              font-family="'Bebas Neue',sans-serif" font-size="9" letter-spacing="0">
          ${label}
        </text>
      </svg>`;
    return L.divIcon({
      className: 'ghost-pin',
      html: svg,
      iconSize:    [36, 46],
      iconAnchor:  [18, 46],
      popupAnchor: [0, -48],
    });
  }

  // ── Initialize map ─────────────────────────────────────────
  const map = L.map('map', {
    zoomControl: true,
    scrollWheelZoom: true,
  });

  // CartoDB Dark Matter — free, no API key, matches dark mode
  L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>' +
      ' contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
    subdomains: 'abcd',
    maxZoom: 19,
  }).addTo(map);

  // ── Route polyline ─────────────────────────────────────────
  const routeCoords = stops.map(s => s.coordinates as [number, number]);
  L.polyline(routeCoords, {
    color:     '#e8841a',
    weight:    2,
    opacity:   0.35,
    dashArray: '6 4',
  }).addTo(map);

  // ── Story markers ──────────────────────────────────────────
  stops.forEach(stop => {
    const excerptShort = stop.excerpt.length > 130
      ? stop.excerpt.slice(0, 130).trimEnd() + '…'
      : stop.excerpt;

    const popupHtml = `
      <h3>${stop.title}</h3>
      <p class="popup-town">${stop.town}</p>
      <p>${excerptShort}</p>
      <a href="/stories/${stop.slug}/">Read the Full Story &rarr;</a>`;

    L.marker(stop.coordinates as [number, number], { icon: ghostIcon(stop.order) })
      .addTo(map)
      .bindPopup(popupHtml, { maxWidth: 260 });
  });

  // ── Fit all pins in view ────────────────────────────────────
  if (routeCoords.length > 0) {
    map.fitBounds(L.latLngBounds(routeCoords), { padding: [40, 40] });
  }

  // ── Dismiss hint on first interaction ──────────────────────
  map.once('popupopen', () => {
    hint?.classList.add('hidden');
  });
</script>
